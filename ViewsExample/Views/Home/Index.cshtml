@using ViewsExample.Models

@{
    string appTitle = "Asp.Net Core";

  List<Person> persons = new List<Person>()
  {
      new Person{PersonName="John", DateOfBirth=new DateTime(1990,1,1), PersonGender=Gender.Male},
      new Person{PersonName="Jane", DateOfBirth=new DateTime(1995,5,15), PersonGender=Gender.Female},
      new Person{PersonName="Alex", DateOfBirth=new DateTime(1995,6,15), PersonGender=Gender.Trans}
  };
}
@{
    
    <!Doctype =" <html xmlns="http://www.w3.org/1999/xhtml">
    <html>
    <head>
        <title>@appTitle</title>
        <meta charset="utf-8" />
    
    </head>
    <body><h1> Welcome</h1>
          @foreach(Person person in persons)
          {
              <div>
                      @person.PersonName
                      <span> , </span>
                      <span> @person.PersonGender  </span>

                     <span>@person.DateOfBirth.Value.ToString("MM/dd/yyyy")</span>
              </div>
          }
    </body>
</html>
}
